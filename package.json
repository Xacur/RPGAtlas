{
  "name": "rpgatlas-desktop",
  "version": "2.1.0",
  "private": true,
  "description": "Tauri desktop wrapper for the RPGAtlas editor",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src tests-unit \"*.mjs\"",
    "test": "node --test tests/",
    "test:unit": "vitest run",
    "test:net": "vitest run --config vitest.net.config.mjs",
    "test:e2e": "playwright test",
    "stage": "node scripts/stage-frontend.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:appimage": "node scripts/build-linux-appimage.mjs",
    "package:game:appimage": "node scripts/package-game-appimage.mjs",
    "electron:poc": "node scripts/build-electron-poc.mjs",
    "package:electron:game": "node scripts/package-electron-game.mjs",
    "package:exe": "node scripts/package-exe.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
